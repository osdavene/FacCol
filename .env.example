# Configuración de Entorno FacCol
# IMPORTANTE: No guardes llaves de Wompi ni contraseñas SMTP en .env; configúralas cifradas en /backoffice/configuracion/
DEBUG=False
SECRET_KEY=cambiar-por-clave-secreta-larga-y-segura
# Llave independiente recomendada para cifrado Fernet en BD (para poder rotar SECRET_KEY sin perder secretos)
SETTINGS_ENCRYPTION_KEY=
ALLOWED_HOSTS=faccol.servigest.online,127.0.0.1,localhost
SECURE_HSTS_SECONDS=31536000
SECURE_SSL_REDIRECT=False

# Base de datos (PostgreSQL / MySQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=faccol
DB_USER=faccol
DB_PASSWORD=tu_password_seguro
DB_HOST=127.0.0.1
DB_PORT=5432

# URL de la aplicación
APP_URL=https://faccol.servigest.online

# Integración opcional Gemini y Observabilidad Sentry
GEMINI_API_KEY=
SENTRY_DSN=
GUNICORN_WORKERS=

# Correo Electrónico (Prioridad estricta .env — Resend API y respaldo SMTP)
RESEND_API_KEY=
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notificaciones@servigest.online
MAIL_FROM_NAME="FacCol — ServiGest"
MAIL_ADMIN_RECIPIENT=servigestonline@gmail.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
