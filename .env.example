# Configuración de Entorno FacCol
DEBUG=False
SECRET_KEY=cambiar-por-clave-secreta-larga-y-segura
ALLOWED_HOSTS=faccol.com,www.faccol.com,127.0.0.1,localhost

# Base de datos PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=faccol
DB_USER=faccol
DB_PASSWORD=tu_password_seguro
DB_HOST=127.0.0.1
DB_PORT=5432

# URL de la aplicación
APP_URL=https://faccol.com

# Integración de Inteligencia Artificial (Google Gemini)
GEMINI_API_KEY=

# Pasarela de pagos Wompi (Colombia)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_SANDBOX=False

# Correo del sistema
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=notificaciones@faccol.com
